{
  "name": "projetnyxt",
  "version": "0.6.0",
  "description": "Projet Nyxt — jeu web type Brawl Stars (Battle Royale). Extensible : Zareks, cartes et modes pilotés par des données.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node server/smoke.mjs",
    "server": "tsx watch server/index.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --target=node18 --external:bufferutil --external:utf-8-validate --outfile=server/nyxt-server.cjs",
    "start:server": "node server/nyxt-server.cjs"
  },
  "keywords": [
    "game",
    "phaser",
    "brawl-stars",
    "battle-royale"
  ],
  "license": "MIT",
  "dependencies": {
    "@colyseus/core": "^0.18.23",
    "@colyseus/ws-transport": "^0.18.4",
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.6",
    "@types/node": "^26.6.5",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
